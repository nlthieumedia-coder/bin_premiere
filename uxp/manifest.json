{
  "manifestVersion": 5,
  "id": "com.antigravity.premierebinbuilder",
  "name": "PremiereBinBuilder",
  "version": "1.0.0",
  "main": "src/index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "premiereBinBuilderPanel",
      "label": {
        "default": "PremiereBinBuilder"
      },
      "minimumSize": {
        "width": 250,
        "height": 350
      },
      "preferredSize": {
        "width": 320,
        "height": 600
      }
    }
  ]
}
